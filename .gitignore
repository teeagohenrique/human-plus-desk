# Ambiente virtual e dependencias instaladas
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Cobertura de testes (artefato local)
.coverage
htmlcov/

# Segredos (nunca versionar chaves de API)
.env
.env.*
!.env.example

# Logs de auditoria e do painel (podem conter texto dos chamados)
data/*.jsonl
*.log

# Banco SQLite local (recriado pelo seed na primeira execução)
human_desk.db
human_desk.db-wal
human_desk.db-shm

# Arquivos do sistema
Thumbs.db
.DS_Store

# Notas de estudo, revisões e roteiros locais (fora do pacote de código)
_revisoes/
*_Roteiro_Apresentacao*
